# Local macOS deployment settings. Copy to local-machine.env and keep it mode 600.
# This file is deliberately separate from config.yaml: launchd cannot inherit your
# interactive shell environment, and the collector API token must stay private.

PIPELINE_HOME=/Users/wangkp/Developer/ai-news-pipeline
COLLECTOR_HOME=/Users/wangkp/Developer/public-source-collector

PIPELINE_CONFIG=/Users/wangkp/Developer/ai-news-pipeline/config.yaml
PIPELINE_SECRETS=/Users/wangkp/Developer/ai-news-pipeline/secrets.yaml
COLLECTOR_CONFIG=/Users/wangkp/Developer/public-source-collector/collector.toml

COLLECTOR_API_HOST=127.0.0.1
COLLECTOR_API_PORT=4100
COLLECTOR_API_URL=http://127.0.0.1:4100

# Create a long random value and use the exact same value here and for the API.
# Never add it to config.yaml, plist files, shell history, or source control.
PUBLIC_SOURCE_COLLECTOR_PIPELINE_TOKEN=

# The WeChat article read API (GET /api/v1/pipeline/wechat/articles) reuses the
# collector's pipeline token as its Bearer credential.
WECHAT_READ_API_TOKEN=

# Defaults to no automatic upload. Publishing remains controlled by config.yaml.
# Set to false to let the daily report create a WeChat draft automatically.
PIPELINE_NO_PUBLISH_DEFAULT=true

# Local-only WeChat admin console credentials (never commit, never log).
WECHAT_COLLECTOR_ADMIN_PASSWORD=
WECHAT_COLLECTOR_ADMIN_SESSION_SECRET=

AI_NEWS_CONSOLE_HOST=127.0.0.1
AI_NEWS_CONSOLE_PORT=4102
